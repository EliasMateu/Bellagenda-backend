# Copie para .env (nao versionado) e ajuste. Valores abaixo sao apenas de desenvolvimento.
DJANGO_SECRET_KEY=troque-esta-chave-de-desenvolvimento
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

POSTGRES_DB=bellagenda
POSTGRES_USER=bellagenda
POSTGRES_PASSWORD=troque-a-senha-de-desenvolvimento
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Papel de aplicacao (sem DDL), criado pelo script de init do Postgres.
POSTGRES_APP_USER=bellagenda_app
POSTGRES_APP_PASSWORD=troque-a-senha-do-app-de-desenvolvimento

# "app" (padrao) ou "owner". Use owner para migrate e testes.
DJANGO_DB_ROLE=app

# Opcional: nome do banco de testes (evita colisao entre executores).
# POSTGRES_TEST_DB=test_bellagenda
