# Copie para .env (nao versionado) e ajuste. Valores abaixo sao apenas de desenvolvimento.
DJANGO_SECRET_KEY=troque-esta-chave-de-desenvolvimento
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

POSTGRES_DB=bellagenda
POSTGRES_USER=bellagenda
POSTGRES_PASSWORD=troque-a-senha-de-desenvolvimento
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Papel de aplicacao (sem DDL), criado pelo script de init do Postgres.
POSTGRES_APP_USER=bellagenda_app
POSTGRES_APP_PASSWORD=troque-a-senha-do-app-de-desenvolvimento

# "app" (padrao) ou "owner". Use owner para migrate e testes.
DJANGO_DB_ROLE=app

# Opcional: nome do banco de testes (evita colisao entre executores).
# POSTGRES_TEST_DB=test_bellagenda

# Cookies seguros: True em producao (HTTPS). Origens CSRF confiaveis separadas por virgula.
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_CSRF_TRUSTED_ORIGINS=

# Caminho do backoffice (Django admin). Em producao defina um valor proprio e nao obvio.
DJANGO_ADMIN_PATH=gestao-interna

# Cadastro aberto de profissionais (False ate o MVP-2). Contas novas entram como pendentes.
DJANGO_CADASTRO_ABERTO=False
# Teto de contas pendentes aguardando aprovacao (cadastro devolve 409 ao atingir).
DJANGO_CADASTRO_MAX_PENDENTES=50
# Versao vigente dos termos de uso (o cadastro exige o aceite exatamente desta versao).
DJANGO_TERMOS_VERSAO=2026-10-provisorio
