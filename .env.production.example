# PRODUCAO. Copie para .env.production (NUNCA versionado) e troque TODOS os valores TROQUE-*.
# Gere segredos com os comandos do docs/DEPLOY.md. Use com:
#   docker compose --env-file .env.production -f docker-compose.prod.yml ...

# ---- Django -------------------------------------------------------------------------------------
# Chave secreta: no minimo 50 caracteres aleatorios.
DJANGO_SECRET_KEY=TROQUE-gere-uma-chave-aleatoria-de-pelo-menos-50-caracteres
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=srv2037119.hstgr.cloud
# Origem do frontend (Vercel), com https e sem barra final. Varias separadas por virgula.
DJANGO_CSRF_TRUSTED_ORIGINS=https://SEU-PROJETO.vercel.app
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
# Caminho do backoffice (Django admin): OBRIGATORIO em producao, nao obvio. Ex.: gestao-3f9a1c7e
DJANGO_ADMIN_PATH=TROQUE-gestao-aleatorio
# Cadastro aberto de profissionais (False ate o MVP-2).
DJANGO_CADASTRO_ABERTO=False
DJANGO_CADASTRO_MAX_PENDENTES=50
DJANGO_TERMOS_VERSAO=2026-10-provisorio
# Segredo compartilhado com o proxy do frontend (cabecalho X-Bela-Proxy-Secret), minimo 32 caracteres.
# Libera a leitura do IP real do cliente (X-Bela-Client-Ip). O MESMO valor vai na Vercel.
DJANGO_PROXY_SECRET=TROQUE-gere-um-segredo-aleatorio-de-pelo-menos-32-caracteres
# Opcional: redirecionar HTTP->HTTPS tambem no Django (o Caddy ja redireciona). Padrao False.
DJANGO_SSL_REDIRECT=False

# ---- Caddy --------------------------------------------------------------------------------------
# Endereco do site (HTTPS automatico). Padrao: hostname da VPS.
SITE_ADDRESS=srv2037119.hstgr.cloud

# ---- PostgreSQL (tres credenciais DIFERENTES) ---------------------------------------------------
# Banco da aplicacao.
POSTGRES_DB=bellagenda
# Superusuario do CONTAINER (nao pode comecar com pg_): so cria papeis/banco na primeira subida. A aplicacao nunca o usa.
POSTGRES_SUPERUSER=bela_postgres
POSTGRES_SUPERUSER_PASSWORD=TROQUE-senha-superusuario
# Papel DONO (nao superusuario): usado apenas para migrate/createcachetable.
POSTGRES_OWNER_USER=bellagenda_dono
POSTGRES_OWNER_PASSWORD=TROQUE-senha-dono
# Papel de APLICACAO (CRUD, sem DDL): usado pelo Gunicorn.
POSTGRES_APP_USER=bellagenda_app
POSTGRES_APP_PASSWORD=TROQUE-senha-aplicacao
